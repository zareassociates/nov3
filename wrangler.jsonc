{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nov3",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9e6f11bb-3c11-4fdf-859c-e041f8c657d1","database_name": "nov3db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "89bf770201854517837c7ed6bbc737fa" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
